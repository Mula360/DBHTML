# ---- Supabase (all server-side; no NEXT_PUBLIC_ prefix) ----
SUPABASE_URL=                         # https://<ref>.supabase.co  (note: .co, not .com)
SUPABASE_ANON_KEY=                    # the "anon" publishable key (safe server-side; RLS-gated)
SUPABASE_SERVICE_ROLE_KEY=            # the service_role key — bypasses RLS, keep secret

# ---- App ----
APP_URL=http://localhost:3000         # the deployed URL in production
CRON_SECRET=                          # random string; sent as "Bearer <value>" to /api/cron/daily

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=ec@your-verified-domain.org

# ---- AI minutes extraction (leave blank until used) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                      # optional; default claude-sonnet-4-6

# ---- Google Workspace: Meet attendance + Gemini notes ingestion ----
# All optional. Unset = the app stays in manual-notes-import mode.
GOOGLE_SA_KEY_JSON=                   # service-account JSON key, single line
GOOGLE_IMPERSONATE_SUBJECT=           # organiser Workspace email to impersonate
GOOGLE_MEET_SPACE_CODE=               # standing EC Meet code, e.g. abc-defg-hij
GOOGLE_NOTES_FOLDER_ID=               # optional Drive folder id for the notes Docs

# ---- Auth ----
ALLOW_PASSWORD_LOGIN=                 # on by default; set to "false" for magic-link-only once email delivery works

# The app also still reads the old NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY /
# NEXT_PUBLIC_APP_URL names as a fallback, so a partial migration won't break —
# but remove those from the host once the names above are set.
